# Supabase (client-side, exposed to browser)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# API server URL (the Express backend on Railway)
# In development, point to your local Express server.
# In production, point to your Railway URL.
VITE_API_URL=http://localhost:3001

# Firebase (client-side, for Phone Auth)
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_APP_ID=your-app-id

# --- The following are used ONLY by the Express server (/server directory) ---
# They are NOT used by the frontend. Set them in the server's .env or Railway env.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# APP_JWT_SECRET=your-jwt-secret
# APP_JWT_EXPIRY=12h
# CORS_ORIGIN=https://your-frontend.vercel.app
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_CLIENT_EMAIL=your-client-email
# FIREBASE_PRIVATE_KEY=your-private-key
